{
  "manifest_version":3,
  "name":"Chess Browser Assistant",
  "version":"0.1.0",
  "description":"Treinamento local com Stockfish para bots, análise e tabuleiro local. Partidas humanas bloqueadas.",
  "minimum_chrome_version":"116",
  "permissions":["storage","offscreen"],
  "background":{"service_worker":"background.js"},
  "action":{"default_popup":"popup.html"},
  "content_scripts":[{"matches":["https://www.chess.com/*","http://127.0.0.1:8787/chess-board.html*"],"js":["content.js"],"run_at":"document_idle"}],
  "content_security_policy":{"extension_pages":"script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'; connect-src 'self'"}
}
