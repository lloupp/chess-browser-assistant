{
  "name": "xadrez-local",
  "version": "0.2.0",
  "description": "Offline Android chess app powered locally by Stockfish, with practice and post-game review",
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc",
    "test": "npm run build && vitest run",
    "build": "node scripts/build.mjs",
    "build:android": "node scripts/build-android-assets.mjs",
    "test:e2e": "playwright test",
    "test:integration": "vitest run tests/engine.integration.test.ts",
    "fixture": "node scripts/fixture-server.mjs",
    "build:dev": "node scripts/build.mjs --dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lloupp/chess-browser-assistant.git"
  },
  "keywords": ["chess","android","stockfish","offline"],
  "author": "",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "bugs": {
    "url": "https://github.com/lloupp/chess-browser-assistant/issues"
  },
  "homepage": "https://github.com/lloupp/chess-browser-assistant#readme",
  "dependencies": {
    "chess.js": "1.4.0",
    "stockfish": "18.0.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/chrome": "0.3.4",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "jsdom": "30.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  }
}
